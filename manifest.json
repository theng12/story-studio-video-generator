{
  "manifest_version": 3,
  "name": "Story Studio Video Generator",
  "version": "1.0.0",
  "description": "Generate paid Flow/Veo scene videos from Story Studio motion prompts and save them to the episode or Downloads.",
  "permissions": [
    "alarms",
    "downloads",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://flow-content.google/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Story Studio Video Generator"
  },
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  }
}
